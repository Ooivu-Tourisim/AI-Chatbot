# ──────────────────────────────────────────────
# Aura Travel Assistant — Environment Variables
# ──────────────────────────────────────────────
# Copy this file to .env and fill in your values:
#   cp .env.example .env       (macOS/Linux)
#   copy .env.example .env     (Windows)

# Gemini API key (required) — get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# Model used by Aura (default: gemini-3.5-flash-lite)
# Options: gemini-3.5-flash-lite, gemini-flash-lite-latest, etc.
GEMINI_MODEL=gemini-3.5-flash-lite
# Package Builder drafts, assistance and packing checklists use Gemini Flash.
GEMINI_BUILDER_MODEL=gemini-3.5-flash
# Language identification and mixed-language speech transcription.
GEMINI_LANGUAGE_MODEL=gemini-3.5-flash-lite

# Branding shown in the assistant's replies
PLATFORM_NAME=North of Ceylon

# Max tokens per response (increase for longer package descriptions)
AURA_MAX_TOKENS=2000

# Comma-separated list of frontend origins allowed by CORS
# Add your production domain when deploying
ALLOWED_ORIGINS=http://localhost:5173
