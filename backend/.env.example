# Same providers and model as Bus Book. Secrets stay in backend/.env.
AGENT_LLM_PROVIDER=groq
AGENT_LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-120b
AGENT_EFFORT=low
AGENT_LLM_TIMEOUT_S=12
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=southeastasia
# Optional custom Azure resource endpoint for fast transcription:
# AZURE_SPEECH_ENDPOINT=https://YOUR-RESOURCE.cognitiveservices.azure.com
AGENT_VOICE_GENDER=female
AGENT_STT_LOCALE_EN=en-IN
AGENT_STT_LOCALE_SI=si-LK
AGENT_STT_LOCALE_TA=ta-IN
# Automatic recognition candidates; no customer language selection is required.
AGENT_STT_AUTO_LOCALES=en-IN,si-LK,ta-IN,ko-KR,hi-IN,it-IT,ar-SA,zh-CN,es-ES,fr-FR,de-DE
AGENT_TTS_LOCALE_EN=en-IN
AGENT_TTS_LOCALE_SI=si-LK
AGENT_TTS_LOCALE_TA=ta-LK
AGENT_VOICE_FEMALE_EN=en-IN-NeerjaNeural
AGENT_VOICE_FEMALE_SI=si-LK-ThiliniNeural
AGENT_VOICE_FEMALE_TA=ta-LK-SaranyaNeural
AGENT_VOICE_MALE_EN=en-IN-PrabhatNeural
AGENT_VOICE_MALE_SI=si-LK-SameeraNeural
AGENT_VOICE_MALE_TA=ta-LK-KumarNeural
PLATFORM_NAME=North of Ceylon
AURA_MAX_TOKENS=2000
ALLOWED_ORIGINS=http://localhost:5173

# Explicit multilingual voice selections (validated against Azure voices/list).
AGENT_STT_LOCALE_DE=de-DE
AGENT_TTS_LOCALE_DE=de-DE
AGENT_VOICE_FEMALE_DE=de-DE-KatjaNeural
AGENT_STT_LOCALE_FR=fr-FR
AGENT_TTS_LOCALE_FR=fr-FR
AGENT_VOICE_FEMALE_FR=fr-FR-DeniseNeural
AGENT_STT_LOCALE_AR=ar-SA
AGENT_TTS_LOCALE_AR=ar-SA
AGENT_VOICE_FEMALE_AR=ar-SA-ZariyahNeural
AGENT_STT_LOCALE_KO=ko-KR
AGENT_TTS_LOCALE_KO=ko-KR
AGENT_VOICE_FEMALE_KO=ko-KR-SunHiNeural
AGENT_STT_LOCALE_ZH=zh-CN
AGENT_TTS_LOCALE_ZH=zh-CN
AGENT_VOICE_FEMALE_ZH=zh-CN-XiaoxiaoNeural
AGENT_STT_LOCALE_HI=hi-IN
AGENT_TTS_LOCALE_HI=hi-IN
AGENT_VOICE_FEMALE_HI=hi-IN-SwaraNeural
AGENT_STT_LOCALE_IT=it-IT
AGENT_TTS_LOCALE_IT=it-IT
AGENT_VOICE_FEMALE_IT=it-IT-ElsaNeural
AGENT_STT_LOCALE_ES=es-ES
AGENT_TTS_LOCALE_ES=es-ES
AGENT_VOICE_FEMALE_ES=es-ES-ElviraNeural
